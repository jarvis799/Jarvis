<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                            <corners android:radius="16dp" />
                            <gradient
                                android:type="linear"
                                android:angle="135"
                                android:startColor="?attr/themeCardGlassStart"
                                android:endColor="?attr/themeCardGlassEnd" />
                            <stroke
                                android:width="1.2dp"
                                android:color="?attr/themeCardBorder" />
                        </shape>
            </item>
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <gradient
                    android:type="linear"
                    android:angle="270"
                    android:startColor="#2EFFFFFF"
                    android:endColor="#00FFFFFF" />
            </shape>
        </item>
        </layer-list>
    </item>
</ripple>
