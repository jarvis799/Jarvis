<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle">
        <corners android:radius="36dp" />
        <gradient android:angle="270" android:startColor="?attr/themeDockGlassStart" android:endColor="?attr/themeDockGlassEnd" />
        <stroke android:width="1dp" android:color="?attr/themeDockBorder" />
    </shape></item>
    <item android:top="1dp" android:bottom="32dp" android:left="8dp" android:right="8dp"><shape android:shape="rectangle">
        <corners android:topLeftRadius="30dp" android:topRightRadius="30dp" android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
        <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
    </shape></item>
</layer-list>
