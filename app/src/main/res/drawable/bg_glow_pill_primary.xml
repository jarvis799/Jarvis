<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="?attr/themeCardBorder" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="?attr/themeAccent1"
                android:endColor="?attr/themeAccent2" />
            <stroke
                android:width="1.2dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
    <item
        android:top="4dp"
        android:bottom="14dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
