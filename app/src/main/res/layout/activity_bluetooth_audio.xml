<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_jarvis_icon_square"
                    android:src="@drawable/ic_back"
                    app:tint="?attr/themeTextPrimary"
                    android:contentDescription="Back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bluetooth Audio"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Microphone and speaker routing"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvConnectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NO BLUETOOTH AUDIO"
                    android:textColor="?attr/themeAccent"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Checking connected devices"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Output"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Input"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMicAvailable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Microphone status"
                    android:textColor="?attr/themeAccent"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoRouting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Automatic audio routing"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swPreferOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Prefer Bluetooth output"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swPreferFallback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Phone microphone fallback"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnTestMic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Test microphone"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnTestSpeaker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Test speaker"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Reset audio routing"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvMicResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text=""
                android:textColor="?attr/themeTextMuted"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
