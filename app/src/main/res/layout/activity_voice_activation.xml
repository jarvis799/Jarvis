<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_jarvis_icon_square"
                    android:src="@drawable/ic_back"
                    app:tint="?attr/themeTextPrimary"
                    android:contentDescription="Back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice Activation"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hey JARVIS • detection engine status"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvEngineBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETECTION ENGINE IDLE"
                    android:textColor="?attr/themeAccent"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvEngineDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Checking this device"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvMicStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Microphone permission"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp" />
            <TextView
                android:id="@+id/btnMicPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Grant microphone permission"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

                <TextView
                    android:id="@+id/tvAssistantStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Default assistant status"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp" />
            <TextView
                android:id="@+id/btnAssistant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Open digital assistant settings"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

                <TextView
                    android:id="@+id/tvWakePhrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Hey JARVIS"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp" />
            <TextView
                android:id="@+id/btnWakePhrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Edit custom wake phrase"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wake activations: 0"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/tvBatteryStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Battery state"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnTestWake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Test wake word now"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Enable Hey JARVIS"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnDisable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Disable voice activation"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
