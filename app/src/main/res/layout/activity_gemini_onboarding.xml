<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:apk="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_onb_gradient"
    android:fitsSystemWindows="true">

    <!-- Three segment onboarding progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/progressOne"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_onb_progress_active" />

        <View
            android:id="@+id/progressTwo"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_onb_progress_idle" />

        <View
            android:id="@+id/progressThree"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_onb_progress_idle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_sparkle"
                    android:contentDescription="Gemini"
                    android:tint="@color/onb_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Connect Your Gemini Key"
                    android:textColor="@color/onb_heading"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Jarvis uses Google Gemini AI to understand your voice and generate intelligent responses. Add your free API key to get started."
                android:textColor="@color/onb_body"
                android:textSize="13.5sp"
                android:lineSpacingExtra="4dp" />

            <!-- Step 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_onb_step_circle"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/onb_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Tap “Get Free Key” below to open Google AI Studio."
                    android:textColor="@color/onb_body"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Step 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_onb_step_circle"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/onb_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Sign in with your Google account."
                    android:textColor="@color/onb_body"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Step 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_onb_step_circle"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/onb_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Tap “Create API Key” and copy your key."
                    android:textColor="@color/onb_body"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Step 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_onb_step_circle"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/onb_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Return to Jarvis and paste your API key below."
                    android:textColor="@color/onb_body"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGetFreeKey"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_onb_glass_pill"
                android:drawableStart="@drawable/ic_external_link"
                android:drawablePadding="10dp"
                android:drawableTint="@color/onb_green"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Get Free Key"
                android:textAllCaps="false"
                android:textColor="@color/onb_heading"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_onb_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">

                <EditText
                    android:id="@+id/etApiKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Enter your Gemini API key here"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/onb_heading"
                    android:textColorHint="@color/onb_muted"
                    android:textSize="14.5sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_settings_lock"
                    android:contentDescription="Encrypted"
                    android:tint="@color/onb_muted" />

                <TextView
                    android:id="@+id/tvToggleKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:drawableStart="@drawable/ic_visibility"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/onb_green"
                    android:text=""
                    android:textColor="@color/onb_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPasteKey"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_onb_glass_pill"
                android:drawableStart="@drawable/ic_key"
                android:drawablePadding="10dp"
                android:drawableTint="@color/onb_green"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Paste Key"
                android:textAllCaps="false"
                android:textColor="@color/onb_heading"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_onb_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_settings_shield"
                    android:contentDescription="Secure"
                    android:tint="@color/onb_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Your API key is stored securely on your device and is only used by Jarvis to connect to Gemini AI."
                    android:textColor="@color/onb_body"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="6dp"
        android:paddingBottom="18dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_onb_lime_pill"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawablePadding="8dp"
            android:drawableTint="#FFFFFF"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Save &amp; Continue"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/tvHaveKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="I already have a key"
            android:textColor="@color/onb_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvManageKeys"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:drawableStart="@drawable/ic_settings_lock"
                android:drawablePadding="8dp"
                android:drawableTint="@color/onb_muted"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Manage my keys"
                android:textColor="@color/onb_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="6dp"
                android:drawableTint="@color/onb_muted"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="12dp"
                android:text="Skip for now"
                android:textColor="@color/onb_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>